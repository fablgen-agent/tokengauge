[Unit]
Description=Cloudflare Tunnel for TokenGauge
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target tokengauge.service
Wants=network-online.target
Requires=tokengauge.service

[Service]
Type=simple
User=admin
Group=admin
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /home/admin/.cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/admin/.cloudflared

[Install]
WantedBy=multi-user.target
