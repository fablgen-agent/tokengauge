{
  "name": "tokengauge",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pricing:verify": "node scripts/verify-pricing-sources.mjs",
    "pricing:refresh": "node scripts/verify-pricing-sources.mjs --write && node scripts/generate-pricing-contract.mjs",
    "pricing:contract": "node scripts/generate-pricing-contract.mjs",
    "pricing:contract:check": "node scripts/generate-pricing-contract.mjs --check",
    "catalogue:compile": "node scripts/compile-method-catalogue.mjs",
    "atlas:compile": "node scripts/compile-research-atlas.mjs",
    "atlas:verify": "node scripts/compile-research-atlas.mjs --check",
    "funnel:report": "node scripts/report-funnel.mjs",
    "backup:test": "node --test scripts/backup-database.test.mjs",
    "check": "npm run atlas:verify && npm run pricing:contract:check && npm run lint && npm run typecheck && npm test && npm run backup:test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.42",
    "@opencoredev/loginwithchatgpt-ai": "0.2.0",
    "@opencoredev/loginwithchatgpt-core": "0.2.0",
    "@opencoredev/loginwithchatgpt-react": "0.2.0",
    "@opencoredev/loginwithchatgpt-server": "0.2.0",
    "ai": "7.0.66",
    "better-auth": "^1.6.29",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
